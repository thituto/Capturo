<Window x:Class="Capturo.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de imagens do Capturo"
        Width="1280" Height="820" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#2D2D30"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BarBackground" Color="#3C3C3F" />
        <SolidColorBrush x:Key="BarText" Color="#E6E6E6" />
        <SolidColorBrush x:Key="ToolBlue" Color="#3E7FCB" />
        <SolidColorBrush x:Key="ToolActive" Color="#F59E0B" />

        <!-- Botão grande da barra de cima: ícone num círculo colorido (Background) e o nome embaixo (Tag). -->
        <Style x:Key="RibbonButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="6,4,6,3" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <Grid Width="26" Height="26" HorizontalAlignment="Center">
                                    <Ellipse Fill="{TemplateBinding Background}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontFamily="Segoe MDL2 Assets" TextElement.FontSize="13"
                                                      TextElement.Foreground="White" />
                                </Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource BarText}" FontSize="11.5"
                                           HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A4A4E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#55555A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setinha ao lado de um botão grande, que abre o menu de opções dele. -->
        <Style x:Key="DropArrow" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BarText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="2">
                            <TextBlock Text="▾" FontSize="12" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4A4A4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ferramenta da barra da esquerda: círculo azul pequeno; a escolhida fica laranja. -->
        <Style x:Key="ToolRadio" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="22" Height="22" Background="Transparent">
                            <Ellipse x:Name="Dot" Fill="{StaticResource ToolBlue}" />
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="White" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ToolActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9A9AE" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de cima, no estilo faixa de botões grandes. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBackground}" BorderBrush="#29292B" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="2,3,2,3">
                <Button x:Name="CopyCloseButton" Style="{StaticResource RibbonButton}" Background="#3FA34D" Content="&#xE74E;" Tag="Copiar &amp; Sair"
                        ToolTip="Copia a imagem, salva e fecha o editor (Ctrl+Enter)" Click="CopyClose_Click" />
                <Button Style="{StaticResource DropArrow}" Click="CopyCloseMenu_Click" ToolTip="Mais opções de saída" />
                <Button Style="{StaticResource RibbonButton}" Background="Transparent" Content="&#xE792;" Tag="Salvar como" ToolTip="Ctrl+Shift+S" Click="SaveAs_Click" />
                <Button Style="{StaticResource RibbonButton}" Background="Transparent" Content="&#xE749;" Tag="Imprimir" ToolTip="Ctrl+P" Click="Print_Click" />
                <Button x:Name="PropertiesButton" Style="{StaticResource RibbonButton}" Background="#3E7FCB" Content="&#xE8FD;" Tag="Propriedades"
                        ToolTip="Mostrar ou esconder o painel de cor, tamanho e estilo (F4)" Click="Properties_Click" />
                <Button Style="{StaticResource DropArrow}" Click="Properties_Click" />
                <Button Style="{StaticResource RibbonButton}" Background="#3FA34D" Content="&#xE8C8;" Tag="Copiar" ToolTip="Ctrl+C" Click="Copy_Click" />
                <Button Style="{StaticResource DropArrow}" Click="CopyMenu_Click" ToolTip="Outras formas de copiar" />
                <Button x:Name="UndoButton" Style="{StaticResource RibbonButton}" Background="#E08A1E" Content="&#xE7A7;" Tag="Desfazer" ToolTip="Ctrl+Z" Click="Undo_Click" />
                <Button Style="{StaticResource DropArrow}" Click="UndoMenu_Click" ToolTip="Refazer e desfazer tudo" />
                <Button Style="{StaticResource RibbonButton}" Background="#3E7FCB" Content="&#xE7A8;" Tag="Cortar" ToolTip="Arraste a área que deve ficar (C)" Click="Crop_Click" />
                <Button Style="{StaticResource DropArrow}" Click="CropMenu_Click" ToolTip="Opções de corte" />
                <Button Style="{StaticResource RibbonButton}" Background="#3E7FCB" Content="&#xE8C6;" Tag="Recortar"
                        ToolTip="Remove uma faixa do meio da imagem e junta as partes" Click="CutOut_Click" />
                <Button Style="{StaticResource RibbonButton}" Background="#3E7FCB" Content="&#xE740;" Tag="Redimensionar" ToolTip="Mudar o tamanho da imagem" Click="Resize_Click" />
                <Button Style="{StaticResource RibbonButton}" Background="#3E7FCB" Content="&#xE9A6;" Tag="Tamanho da tela" ToolTip="Aumentar a área da imagem com margens" Click="CanvasSize_Click" />
                <Button x:Name="BordersButton" Style="{StaticResource RibbonButton}" Background="#C62835" Content="&#xE7FB;" Tag="Bordas"
                        ToolTip="Borda, sombra, cantos arredondados e borda rasgada" Click="Borders_Click" />
                <Button x:Name="PublishButton" Style="{StaticResource RibbonButton}" Background="#4A4A50" Content="&#xE72D;" Tag="Publicar"
                        ToolTip="Mostrar na pasta, abrir com outro programa ou copiar o caminho" Click="Publish_Click" />
            </StackPanel>
        </Border>

        <!-- Rodapé: tamanho da imagem e zoom. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BarBackground}" Height="22">
            <DockPanel Margin="6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomText" Foreground="#A9A9AE" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="−" Width="16" Height="16" Padding="0" FontSize="11" Click="ZoomOut_Click" ToolTip="Diminuir (Ctrl+-)" />
                    <Slider x:Name="ZoomSlider" Width="130" Minimum="5" Maximum="400" Value="100" VerticalAlignment="Center" Margin="4,0"
                            ValueChanged="ZoomSlider_ValueChanged" ToolTip="Ctrl+roda do mouse · Ctrl+0: 100% · Ctrl+1: ajustar" />
                    <Button Content="+" Width="16" Height="16" Padding="0" FontSize="11" Click="ZoomIn_Click" ToolTip="Aumentar (Ctrl++)" />
                </StackPanel>
                <TextBlock x:Name="SizeText" Foreground="#A9A9AE" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Foreground="#7E7E85" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Ferramentas de desenho, em coluna. -->
        <Border DockPanel.Dock="Left" Background="{StaticResource BarBackground}" Width="28">
            <StackPanel x:Name="ToolPanel" HorizontalAlignment="Center" Margin="0,6,0,0">
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Arrow" ToolTip="Seta (A)" Content="➚" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Rectangle" ToolTip="Retângulo (R)" Content="▭" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Text" ToolTip="Texto (T)" Content="A" FontFamily="Georgia" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Callout" ToolTip="Balão de texto (K)" Content="&#xE8BD;" FontFamily="Segoe MDL2 Assets" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Step" ToolTip="Numeração de passos (N)" Content="1" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Spotlight" ToolTip="Destaque: escurece o resto (S)" Content="&#xE7E6;" FontFamily="Segoe MDL2 Assets" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Ellipse" ToolTip="Elipse (E)" Content="◯" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Stamp" ToolTip="Carimbo (J)" Content="★" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Pen" ToolTip="Lápis (P)" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Pixelate" ToolTip="Desfocar / ocultar (B)" Content="▦" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Image" ToolTip="Inserir imagem (I) · ou Ctrl+V" Content="&#xE8B9;" FontFamily="Segoe MDL2 Assets" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Magnifier" ToolTip="Lupa (M)" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Brace" ToolTip="Chave (G)" Content="}" />
                <Rectangle Height="1" Margin="2,6" Fill="#55555A" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Line" ToolTip="Linha (L)" Content="╱" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Highlighter" ToolTip="Marca-texto (H)" Content="▌" />
                <RadioButton Style="{StaticResource ToolRadio}" Tag="Select" ToolTip="Selecionar e mover (V)" Content="↖" />
            </StackPanel>
        </Border>

        <!-- Painel de propriedades (botão Propriedades / F4). -->
        <Border x:Name="PropertiesPanel" DockPanel.Dock="Right" Width="214" Background="{StaticResource BarBackground}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,4,12,12">
                    <TextBlock x:Name="PanelTitle" Foreground="{StaticResource BarText}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="Cor" Style="{StaticResource PanelLabel}" />
                    <WrapPanel x:Name="ColorPanel" />
                    <TextBlock Text="Tamanho" Style="{StaticResource PanelLabel}" />
                    <DockPanel>
                        <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Width="22" Foreground="{StaticResource BarText}" TextAlignment="Right" />
                        <Slider x:Name="SizeSlider" Minimum="1" Maximum="12" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SizeSlider_ValueChanged" />
                    </DockPanel>
                    <TextBlock Text="Opacidade" Style="{StaticResource PanelLabel}" />
                    <DockPanel>
                        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="36" Foreground="{StaticResource BarText}" TextAlignment="Right" />
                        <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OpacitySlider_ValueChanged" />
                    </DockPanel>
                    <TextBlock Text="Estilo" Style="{StaticResource PanelLabel}" />
                    <CheckBox x:Name="FillToggle" Content="Preenchido" Margin="0,2" Click="StyleToggle_Click" />
                    <CheckBox x:Name="RoundToggle" Content="Cantos arredondados" Margin="0,2" Click="StyleToggle_Click" />
                    <StackPanel x:Name="StampPanel" Visibility="Collapsed">
                        <TextBlock Text="Símbolo do carimbo" Style="{StaticResource PanelLabel}" />
                        <WrapPanel x:Name="StampGlyphs" />
                    </StackPanel>
                    <TextBlock x:Name="ToolHelp" Foreground="#8E8E95" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Área de edição, com fundo preto. -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="Black" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid x:Name="Stage" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" />
                </Grid.LayoutTransform>
                <Canvas x:Name="ShadowHost" IsHitTestVisible="False" />
                <Grid x:Name="Surface" ClipToBounds="True">
                    <Canvas x:Name="ContentCanvas">
                        <Image x:Name="BaseImage" Stretch="Fill" />
                        <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="OverlayLayer" IsHitTestVisible="False" />
                        <Canvas x:Name="InputLayer" Background="Transparent"
                                MouseLeftButtonDown="Input_MouseDown" MouseMove="Input_MouseMove"
                                MouseLeftButtonUp="Input_MouseUp" />
                    </Canvas>
                    <Canvas x:Name="BorderHost" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
