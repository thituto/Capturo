<Window x:Class="Capturo.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturo"
        Width="1100" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True">
    <DockPanel>
        <!-- Barra de ferramentas -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="8,6">
                <StackPanel x:Name="ToolPanel" Orientation="Horizontal">
                    <ToggleButton Tag="Select" ToolTip="Selecionar e mover (V)" Content="↖ Mover" />
                    <ToggleButton Tag="Arrow" ToolTip="Seta (A)" Content="➜ Seta" />
                    <ToggleButton Tag="Rectangle" ToolTip="Retângulo (R) · Shift: quadrado" Content="▭ Retângulo" />
                    <ToggleButton Tag="Ellipse" ToolTip="Elipse (E) · Shift: círculo" Content="◯ Elipse" />
                    <ToggleButton Tag="Line" ToolTip="Linha (L) · Shift: ângulos de 45°" Content="╱ Linha" />
                    <ToggleButton Tag="Pen" ToolTip="Caneta (P)" Content="✎ Caneta" />
                    <ToggleButton Tag="Highlighter" ToolTip="Marca-texto (H)" Content="▌ Marca-texto" />
                    <ToggleButton Tag="Text" ToolTip="Texto (T) · Enter confirma, Shift+Enter quebra a linha" Content="T Texto" />
                    <ToggleButton Tag="Step" ToolTip="Passo numerado (N)" Content="① Passo" />
                    <ToggleButton Tag="Pixelate" ToolTip="Pixelizar dados sensíveis (B)" Content="▦ Ocultar" />
                    <ToggleButton Tag="Crop" ToolTip="Recortar (C)" Content="⛶ Recortar" />
                </StackPanel>

                <Rectangle Width="1" Margin="8,4" Fill="{StaticResource PanelBorder}" />

                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Tamanho" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="1" Maximum="12" Value="4" IsSnapToTickEnabled="True"
                            TickFrequency="1" VerticalAlignment="Center" ValueChanged="SizeSlider_ValueChanged" />
                    <TextBlock x:Name="SizeValue" Width="22" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <Rectangle Width="1" Margin="8,4" Fill="{StaticResource PanelBorder}" />

                <Button x:Name="UndoButton" Content="↶ Desfazer" ToolTip="Ctrl+Z" Click="Undo_Click" />
                <Button x:Name="RedoButton" Content="↷ Refazer" ToolTip="Ctrl+Y" Click="Redo_Click" />
                <Button Content="⧉ Copiar" ToolTip="Ctrl+C" Click="Copy_Click" />
                <Button Content="💾 Salvar" ToolTip="Ctrl+S" Click="Save_Click" />
                <Button Content="Salvar como…" ToolTip="Ctrl+Shift+S" Click="SaveAs_Click" />
            </WrapPanel>
        </Border>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,5">
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Área de edição -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource CanvasBackground}" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid x:Name="Surface" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" />
                </Grid.LayoutTransform>
                <Canvas x:Name="ContentCanvas">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="CropShift" />
                    </Canvas.RenderTransform>
                    <Image x:Name="BaseImage" Stretch="Fill" />
                    <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="PreviewLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="InputLayer" Background="Transparent"
                            MouseLeftButtonDown="Input_MouseDown" MouseMove="Input_MouseMove"
                            MouseLeftButtonUp="Input_MouseUp" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
